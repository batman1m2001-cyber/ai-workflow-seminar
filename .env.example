# Real mode. Copy to .env and fill in; the keys stay on the runner (never sent to the browser).
# Every real call goes through the runner's router at /llm/v1:
#   model "openai:<name>"  -> OpenAI, that model (e.g. QC l4 asks for openai:gpt-4o)
#   a request with tools  -> OpenAI, SEMINAR_TOOLS_MODEL
#   any other chat        -> the in-house model (INHOUSE_*); OpenAI if INHOUSE_* is empty
#   embeddings            -> OpenAI, SEMINAR_EMBED_MODEL
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SEMINAR_TOOLS_MODEL=gpt-4o-mini
SEMINAR_EMBED_MODEL=text-embedding-3-small

# The in-house model (OpenAI-compatible), e.g. the callbot's gateway
INHOUSE_API_KEY=
INHOUSE_BASE_URL=https://llm-callbot.edupia.com.vn:8689/v1
INHOUSE_MODEL=google/gemma-4-E2B-it
